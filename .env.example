# Copy to .env.local for local development, and set the same variables in your
# hosting provider's environment settings. Never commit real values.
# All variables are server-side only. None use the NEXT_PUBLIC_ prefix, so none
# are sent to the browser.

# --- Site ---------------------------------------------------------------------
# Canonical production origin, used for canonical URLs, sitemap.xml, robots.txt,
# Open Graph URLs and structured data. No trailing slash.
# On Vercel, the production domain is used automatically if this is unset.
SITE_URL=https://www.example.com

# --- Contact form email delivery (Resend — https://resend.com) ------------------
# When any of these are missing, the form tells visitors their message was
# NOT sent instead of showing a false confirmation.
RESEND_API_KEY=
# Inbox that receives website inquiries.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "OptivanceSoft <website@optivancesoft.com>".
CONTACT_FROM_EMAIL=
