# Contact form email delivery (Resend — https://resend.com).
# Copy to .env.local for local development, and set the same variables in your
# hosting provider's environment settings. Never commit real values.
# When any of these are missing, the form shows visitors that their message was
# NOT sent instead of a false confirmation.
RESEND_API_KEY=
# Inbox that receives website inquiries.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "OptivanceSoft <website@optivancesoft.com>".
CONTACT_FROM_EMAIL=
